// use prisma-8

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id      String @id @default(uuid())
  title   String
  content String
  author  User   @relation(fields: [authorId], references: [id])
  authorId String
}